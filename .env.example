########################################
# FlareHub – Environment Configuration
########################################
# Copy this file to ".env" and adjust the values.
# All variables with sensible defaults are optional.

# ============================================================
# GENERAL
# ============================================================
APP_NAME=FlareHub
APP_ENV=production
# Timezone for timestamp display in the dashboard
TZ=Europe/Berlin
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Port Uvicorn listens on internally (inside the container)
APP_PORT=8000
# External (host) port the dashboard is exposed on, mapped to APP_PORT.
# Used by docker-compose.yml (default when unset: 1111).
HOST_PORT=1111
# Default theme on first visit: light or dark
DEFAULT_THEME=dark

# ============================================================
# AUTHENTICATION
# ============================================================
# Auth mode:
#   pin        -> PIN login only
#   passkey    -> Passkey/WebAuthn login only
#   both       -> PIN as fallback, passkey optional (default)
#   none       -> NO authentication (only for isolated internal networks!)
AUTH_MODE=both

# --- PIN login ---
# Plaintext PIN (recommended for Docker: bcrypt hashes contain "$" characters that
# Docker Compose interprets as variable interpolation, which mangles the hash).
# If AUTH_PIN is set, it takes precedence over AUTH_PIN_HASH.
AUTH_PIN=
# Or as a bcrypt hash (alternative to AUTH_PIN). Generate with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'123456', bcrypt.gensalt()).decode())"
# NOTE for Docker: escape "$" in the hash as "$$" (e.g. $$2b$$12$$...) or use AUTH_PIN.
AUTH_PIN_HASH=
# PIN length (number of input fields in the frontend).
# Use 6+ digits for critical infrastructure (default: 6).
AUTH_PIN_LENGTH=6
# Max. failed attempts before a lockout kicks in
AUTH_PIN_MAX_ATTEMPTS=5
# Lockout duration in seconds after too many failed attempts
AUTH_PIN_LOCKOUT_SECONDS=300

# --- Passkey / WebAuthn ---
# Relying Party ID = your domain without protocol/port, e.g. flarehub.example.com
# For local access "localhost" can be used.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=FlareHub
# Full origin incl. protocol & port, must match the URL you call exactly
WEBAUTHN_ORIGIN=http://localhost:8000
# User verification: required, preferred, discouraged
WEBAUTHN_USER_VERIFICATION=preferred
# Attachment: platform (Windows Hello/TouchID), cross-platform (YubiKey), or empty for both
WEBAUTHN_AUTHENTICATOR_ATTACHMENT=

# --- Admin token (passkey management) ---
# Requested on the /settings page to add or delete passkeys.
# Separate from the PIN/passkey login as an additional hurdle for security-relevant actions.
# Set a long random value, e.g.: python3 -c "import secrets; print(secrets.token_hex(24))"
ADMIN_TOKEN=

# --- Session / token ---
# Random, long secret key for token signing (must be changed!)
SESSION_SECRET_KEY=change-me-to-a-long-random-string
# Login token (Bearer) validity in hours. The token lives ONLY in the browser's
# sessionStorage (no cookie) - every new browser visit requires a fresh
# PIN/passkey login. This is just an upper limit.
# Choose a low value for critical infrastructure (default: 4).
SESSION_EXPIRY_HOURS=4
# true (default): pages and API responses get Cache-Control: no-store,
# so no authenticated content is cached by the browser.
# false: browser caching allowed.
HTTP_CACHE_NO_STORE=true
# true (default): sets security headers (CSP, X-Frame-Options: DENY,
# X-Content-Type-Options: nosniff, Referrer-Policy: no-referrer).
SECURITY_HEADERS_ENABLED=true

# ============================================================
# CLOUDFLARE API
# ============================================================
# API token with "Zone.Analytics:Read" and "Zone.Cache Purge:Edit"
# as well as "Zone.Zone Settings:Edit" for dev mode / under attack mode
CLOUDFLARE_API_TOKEN=
# Zone ID of the monitored domain (Cloudflare dashboard -> Overview)
CLOUDFLARE_ZONE_ID=
# Account ID (for account-wide GraphQL queries, optional)
CLOUDFLARE_ACCOUNT_ID=
# API base URL (normally unchanged)
CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_GRAPHQL_URL=https://api.cloudflare.com/client/v4/graphql
# Timeout for Cloudflare requests in seconds
CLOUDFLARE_API_TIMEOUT=15

# ============================================================
# ANALYTICS / COLLECTOR
# ============================================================
# How often (in minutes) new metrics are fetched
COLLECTOR_INTERVAL_MINUTES=10
# Run the collector once on startup instead of waiting
COLLECTOR_RUN_ON_STARTUP=true
# Path to the SQLite database inside the container
DATABASE_PATH=/app/data/cloudflare.db
# Number of data points displayed in the time series chart by default
CHART_DEFAULT_DATAPOINTS=288
# Max. records per Cloudflare GraphQL response (Cloudflare hard limit: 10000)
COLLECTOR_MAX_RECORDS_PER_QUERY=500

# --- Data retention (multi-level aggregation keeps the DB permanently small) ---
# Raw data (10-minute resolution) is compacted into hourly rollups after this time
RAW_RETENTION_HOURS=48
# Hourly rollups are compacted into daily rollups after this time
HOURLY_RETENTION_DAYS=30
# Daily rollups (long-term history, 1 row/day) are deleted after this time
DATA_RETENTION_DAYS=730
# Individual security feed entries (raw, not aggregated) are deleted after this time
THREAT_EVENT_RETENTION_DAYS=30

# ============================================================
# DASHBOARD FEATURES (feature toggles)
# ============================================================
# Enable/disable individual dashboard sections
FEATURE_REQUESTS_CHART=true
FEATURE_BANDWIDTH_CHART=true
FEATURE_CACHE_RATIO_CHART=true
FEATURE_THREATS_CHART=true
FEATURE_SECURITY_FEED=true
# Number of entries in the security feed (WAF/Blocked threats)
SECURITY_FEED_LIMIT=50
# Additional charts (data is collected anyway, only display is toggled)
FEATURE_CACHE_DONUT_CHART=true        # Pie: cached vs. uncached
FEATURE_THREAT_DONUT_CHART=true       # Pie: threat actions (block/challenge/...)
FEATURE_VISITORS_CHART=true           # Unique visitors
FEATURE_PAGEVIEWS_CHART=true          # Page views
FEATURE_CACHED_UNCACHED_CHART=true    # Stacked area: cached vs. uncached
# Passive analytics (read-only GraphQL httpRequestsAdaptiveGroups, last 24h)
FEATURE_COUNTRY_CHART=true            # Donut: top origin countries
FEATURE_STATUS_CHART=true             # Bar: status code groups (2xx/3xx/4xx/5xx)
# Retention of passive analytics snapshots (countries/status) in days
PASSIVE_RETENTION_DAYS=30
# Action Center (own page /actions: cache purge for URLs, manual collector, zone status)
FEATURE_ACTION_CENTER=true
FEATURE_QUICK_ACTIONS=true
FEATURE_DEV_MODE_TOGGLE=true
FEATURE_PURGE_CACHE=true
FEATURE_UNDER_ATTACK_TOGGLE=true
# Auto-refresh of the dashboard in the browser (seconds, 0 = disabled)
DASHBOARD_AUTO_REFRESH_SECONDS=60

# ============================================================
# PRIVACY / MASKING
# ============================================================
# true (default): IPs in the security feed are masked (185.220.xxx.xxx / 2a01:4f8:xxx::).
# Masking can be temporarily disabled on the admin page (/admin)
# (only for the active browser session, requires an admin grant).
MASK_IPS_IN_FEED=true

# ============================================================
# WEBHOOK ALERTING (passive, optional)
# ============================================================
# Notifications on threat spikes (> WEBHOOK_THREAT_THRESHOLD) and
# 5xx errors (> WEBHOOK_5XX_THRESHOLD). Read-only - no write DNS/WAF actions are triggered.
WEBHOOK_ENABLED=false
# Webhook URL (old variable NOTIFY_WEBHOOK_URL is used as fallback)
WEBHOOK_URL=
# Type: discord | telegram | gotify
WEBHOOK_TYPE=discord
# Alarm switches
WEBHOOK_ON_THREAT_SPIKE=true
WEBHOOK_ON_5XX=true
# Thresholds (old NOTIFY_THREAT_THRESHOLD is used as fallback)
WEBHOOK_THREAT_THRESHOLD=100
WEBHOOK_5XX_THRESHOLD=50
# Send a webhook notification after a cache purge quick action
NOTIFY_ON_CACHE_PURGE=true
# Send a webhook notification when the Under Attack Mode is toggled
NOTIFY_ON_UNDER_ATTACK_TOGGLE=true
# Telegram: chat ID (alternatively ?chat_id=... can be appended to WEBHOOK_URL)
WEBHOOK_TELEGRAM_CHAT_ID=
# Gotify: app token for the X-Gotify-Key header (alternatively in the URL)
WEBHOOK_GOTIFY_TOKEN=

# ============================================================
# RATE LIMITING (login protection)
# ============================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_ATTEMPTS_PER_MINUTE=10
