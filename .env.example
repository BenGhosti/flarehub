########################################
# FlareHub – Environment Configuration
########################################
# Kopiere diese Datei nach ".env" und passe die Werte an.
# Alle Variablen mit sinnvollen Defaults sind optional.

# ============================================================
# ALLGEMEIN
# ============================================================
APP_NAME=FlareHub
APP_ENV=production
# Zeitzone für Anzeige von Zeitstempeln im Dashboard
TZ=Europe/Berlin
# Loglevel: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Port, auf dem Uvicorn intern lauscht (im Container)
APP_PORT=8000
# Standard-Theme beim ersten Aufruf: light oder dark
DEFAULT_THEME=dark

# ============================================================
# AUTHENTIFIZIERUNG
# ============================================================
# Auth-Modus:
#   pin        -> nur PIN-Login
#   passkey    -> nur Passkey/WebAuthn-Login
#   both       -> PIN als Fallback, Passkey optional wählbar (Standard)
#   none       -> KEINE Authentifizierung (nur für isolierte interne Netze!)
AUTH_MODE=both

# --- PIN-Login ---
# PIN wird als bcrypt-Hash gespeichert, niemals im Klartext.
# Hash mit: python -c "import bcrypt; print(bcrypt.hashpw(b'123456', bcrypt.gensalt()).decode())"
AUTH_PIN_HASH=
# Länge der PIN (Anzahl der Eingabefelder im Frontend).
# Für kritische Infrastruktur 6+ Stellen verwenden (Standard: 6).
AUTH_PIN_LENGTH=6
# Max. Fehlversuche, bevor ein Lockout greift
AUTH_PIN_MAX_ATTEMPTS=5
# Lockout-Dauer in Sekunden nach zu vielen Fehlversuchen
AUTH_PIN_LOCKOUT_SECONDS=300

# --- Passkey / WebAuthn ---
# Relying Party ID = deine Domain ohne Protokoll/Port, z.B. flarehub.example.com
# Für lokalen Zugriff kann "localhost" verwendet werden.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=FlareHub
# Vollständige Origin inkl. Protokoll & Port, muss exakt zur Aufruf-URL passen
WEBAUTHN_ORIGIN=http://localhost:8000
# User Verification: required, preferred, discouraged
WEBAUTHN_USER_VERIFICATION=preferred
# Attachment: platform (Windows Hello/TouchID), cross-platform (YubiKey), oder leer für beides
WEBAUTHN_AUTHENTICATOR_ATTACHMENT=

# --- Admin-Token (Passkey-Verwaltung) ---
# Wird auf der /settings-Seite abgefragt, um Passkeys hinzuzufügen oder zu löschen.
# Getrennt von PIN/Passkey-Login gedacht als zusätzliche Hürde für sicherheitsrelevante Aktionen.
# Langen, zufälligen Wert setzen, z.B.: python3 -c "import secrets; print(secrets.token_hex(24))"
ADMIN_TOKEN=

# --- Session / Token ---
# Zufälliger, langer Secret-Key für Token-Signierung (unbedingt ändern!)
SESSION_SECRET_KEY=change-me-to-a-long-random-string
# Gültigkeit des Login-Tokens (Bearer) in Stunden. Das Token liegt NUR im
# sessionStorage des Browsers (kein Cookie) - bei jedem neuen Browser-Besuch
# muss man sich neu per PIN/Passkey anmelden. Dies ist nur ein oberes Limit.
# Für kritische Infrastruktur eher niedrig wählen (Standard: 4).
SESSION_EXPIRY_HOURS=4
# true (Standard): Seiten & API-Antworten bekommen Cache-Control: no-store,
# damit kein authentifizierter Inhalt im Browser gecacht wird.
# false: Browser-Caching erlaubt.
HTTP_CACHE_NO_STORE=true
# true (Standard): setzt Security-Header (CSP, X-Frame-Options: DENY,
# X-Content-Type-Options: nosniff, Referrer-Policy: no-referrer).
SECURITY_HEADERS_ENABLED=true

# ============================================================
# CLOUDFLARE API
# ============================================================
# API-Token mit Berechtigung "Zone.Analytics:Read" und "Zone.Cache Purge:Edit"
# sowie "Zone.Zone Settings:Edit" für Dev-Mode / Under Attack Mode
CLOUDFLARE_API_TOKEN=
# Zone ID der zu überwachenden Domain (Cloudflare Dashboard -> Overview)
CLOUDFLARE_ZONE_ID=
# Account ID (für Account-weite GraphQL-Abfragen, optional)
CLOUDFLARE_ACCOUNT_ID=
# API Basis-URL (im Normalfall nicht ändern)
CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_GRAPHQL_URL=https://api.cloudflare.com/client/v4/graphql
# Timeout für Cloudflare-Requests in Sekunden
CLOUDFLARE_API_TIMEOUT=15

# ============================================================
# ANALYTICS / COLLECTOR
# ============================================================
# Wie oft (in Minuten) werden neue Metriken abgerufen
COLLECTOR_INTERVAL_MINUTES=10
# Collector beim Start sofort einmal ausführen statt zu warten
COLLECTOR_RUN_ON_STARTUP=true
# Pfad zur SQLite-Datenbank im Container
DATABASE_PATH=/app/data/cloudflare.db
# Anzahl Datenpunkte, die im Zeitreihen-Chart standardmäßig angezeigt werden
CHART_DEFAULT_DATAPOINTS=288
# Max. Records pro Cloudflare-GraphQL-Antwort (Cloudflare-Hardlimit: 10000)
COLLECTOR_MAX_RECORDS_PER_QUERY=500

# --- Datenaufbewahrung (mehrstufige Aggregation, hält die DB dauerhaft schlank) ---
# Rohdaten (10-Minuten-Auflösung) werden nach dieser Zeit zu Stunden-Rollups verdichtet
RAW_RETENTION_HOURS=48
# Stunden-Rollups werden nach dieser Zeit zu Tages-Rollups verdichtet
HOURLY_RETENTION_DAYS=30
# Tages-Rollups (Langzeitverlauf, 1 Zeile/Tag) werden nach dieser Zeit gelöscht
DATA_RETENTION_DAYS=730
# Einzelne Security-Feed-Einträge (Rohdaten, nicht aggregiert) werden nach dieser Zeit gelöscht
THREAT_EVENT_RETENTION_DAYS=30

# ============================================================
# DASHBOARD FEATURES (Feature-Toggles)
# ============================================================
# Einzelne Bereiche des Dashboards ein-/ausschalten
FEATURE_REQUESTS_CHART=true
FEATURE_BANDWIDTH_CHART=true
FEATURE_CACHE_RATIO_CHART=true
FEATURE_THREATS_CHART=true
FEATURE_SECURITY_FEED=true
# Anzahl der Einträge im Security-Feed (WAF/Blocked Threats)
SECURITY_FEED_LIMIT=50
# Zusätzliche Charts (Daten werden ohnehin gesammelt, nur Anzeige schaltbar)
FEATURE_CACHE_DONUT_CHART=true        # Pie: Cached vs. Uncached
FEATURE_THREAT_DONUT_CHART=true       # Pie: Threat-Aktionen (block/challenge/...)
FEATURE_VISITORS_CHART=true           # Unique Visitors
FEATURE_PAGEVIEWS_CHART=true          # Page Views
FEATURE_CACHED_UNCACHED_CHART=true    # Stacked Area: Cached vs. Uncached
# Passive Analytics (read-only GraphQL httpRequestsAdaptiveGroups, letzte 24h)
FEATURE_COUNTRY_CHART=true            # Donut: Top-Herkunftsländer
FEATURE_STATUS_CHART=true             # Bar: Statuscode-Gruppen (2xx/3xx/4xx/5xx)
# Aufbewahrung der passiven Analytics-Snapshots (Länder/Status) in Tagen
PASSIVE_RETENTION_DAYS=30
# Action Center (eigene Seite /actions: Cache-Purge für URLs, Collector manuell, Zone-Status)
FEATURE_ACTION_CENTER=true
FEATURE_QUICK_ACTIONS=true
FEATURE_DEV_MODE_TOGGLE=true
FEATURE_PURGE_CACHE=true
FEATURE_UNDER_ATTACK_TOGGLE=true
# Auto-Refresh des Dashboards im Browser (Sekunden, 0 = deaktiviert)
DASHBOARD_AUTO_REFRESH_SECONDS=60

# ============================================================
# PRIVACY / MASKING
# ============================================================
# true (Standard): IPs im Security-Feed werden maskiert (185.220.xxx.xxx / 2a01:4f8:xxx::).
# Auf der Admin-Seite (/admin) kann die Maskierung temporär deaktiviert werden
# (nur für die aktive Browser-Session, erfordert Admin-Grant).
MASK_IPS_IN_FEED=true

# ============================================================
# WEBHOOK-ALERTING (passiv, optional)
# ============================================================
# Benachrichtigungen bei Threat-Spikes (> WEBHOOK_THREAT_THRESHOLD) und
# 5xx-Fehlern (> WEBHOOK_5XX_THRESHOLD). Rein lesend - es werden KEINE
# schreibenden DNS-/WAF-Aktionen ausgelöst.
WEBHOOK_ENABLED=false
# URL des Webhooks (Alt-Variable NOTIFY_WEBHOOK_URL wird als Fallback übernommen)
WEBHOOK_URL=
# Typ: discord | telegram | gotify
WEBHOOK_TYPE=discord
# Alarm-Schalter
WEBHOOK_ON_THREAT_SPIKE=true
WEBHOOK_ON_5XX=true
# Schwellenwerte (Alt-Variable NOTIFY_THREAT_THRESHOLD wird als Fallback übernommen)
WEBHOOK_THREAT_THRESHOLD=100
WEBHOOK_5XX_THRESHOLD=50
# Telegram: Chat-ID (Alternativ kann ?chat_id=... in WEBHOOK_URL stehen)
WEBHOOK_TELEGRAM_CHAT_ID=
# Gotify: App-Token für den X-Gotify-Key-Header (alternativ in der URL)
WEBHOOK_GOTIFY_TOKEN=

# ============================================================
# RATE LIMITING (Login-Schutz)
# ============================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_ATTEMPTS_PER_MINUTE=10
